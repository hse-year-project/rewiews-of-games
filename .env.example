# Copy to .env (never commit .env). docker compose reads this file too.

# Local Postgres (docker compose)
PG_HOST=localhost
PG_PORT=5433
PG_DB=steam
PG_USER=steam
PG_PASSWORD=change-me

# Not needed yet. Each developer uses their own key.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
LLM_API_KEY=
